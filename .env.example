# Copy to .env and change the values. .env is ignored by Git.
# Docker Compose reads .env automatically; the Spring Boot app reads these as environment variables
# (export them in your shell or set them in your run configuration).

# Used by docker-compose.yml only (optional, defaults shown)
DB_NAME=nexora
DB_PORT=5432

# Used by both docker-compose.yml and the application
DB_URL=jdbc:postgresql://localhost:5432/nexora
DB_USERNAME=nexora
DB_PASSWORD=change-me-db-password

# Password of the HTTP Basic user "nexora_dev"
NEXORA_DEV_PASSWORD=change-me-api-password
